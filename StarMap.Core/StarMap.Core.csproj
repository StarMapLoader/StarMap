<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;SourceNuget</Configurations>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Lib.Harmony" />
		<PackageReference Include="Samboy063.Tomlet">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\StarMap.API\StarMap.API.csproj" />
		<ProjectReference Include="..\StarMap.Types\StarMap.Types.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<Reference Include="..\..\Import\KSA.dll" />
		<Reference Include="..\..\Import\Brutal.*.dll" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'SourceNuget'">
		<PackageReference Include="RocketWerkz.KSA">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<PackageReference Include="RocketWerkz.KSA.Ref">
			<ExcludeAssets>runtime</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Ahwoo.BRUTAL.Collections">
			<ExcludeAssets>runtime;native</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Ahwoo.BRUTAL.Core">
			<ExcludeAssets>runtime;native</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Ahwoo.BRUTAL.Glfw">
			<ExcludeAssets>runtime;native</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Ahwoo.BRUTAL.ImGui">
			<ExcludeAssets>runtime;native</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Ahwoo.BRUTAL.Localization">
			<ExcludeAssets>runtime;native</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Ahwoo.BRUTAL.Logging">
			<ExcludeAssets>runtime;native</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Ahwoo.BRUTAL.Memory">
			<ExcludeAssets>runtime;native</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Ahwoo.BRUTAL.Numerics">
			<ExcludeAssets>runtime;native</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Ahwoo.BRUTAL.Strings">
			<ExcludeAssets>runtime;native</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Ahwoo.BRUTAL.Vulkan">
			<ExcludeAssets>runtime;native</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions">
			<ExcludeAssets>runtime;native</ExcludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
